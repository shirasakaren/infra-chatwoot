# Secrets / env. .env stays out of git. i cannot stress this enough.
.env
.env.*
!.env.example

# Terraform. local state, locks, plans, tfvars... all local clutter.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Kubeconfig. this is basically a key to the kingdom.
kubeconfig
kubeconfig.*
.kube/

# Ansible droppings
*.retry
.vault_pass
ansible/inventory/*.cache

# OS / editors. nobody needs your .DS_Store in the repo, apple.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Discovery snapshots (regenerated by Terraform; safe to ignore)
terraform/discovery/do-not-touch.json
