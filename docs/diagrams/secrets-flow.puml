@startuml chatwoot-ta-secrets
!theme plain
title Chatwoot-TA — Secrets Flow (no plaintext in Terraform state)

skinparam roundCorner 8
skinparam shadowing false

actor Operator as op
file ".env\n(local laptop)" as env
participant "deploy.sh\nload-secrets.sh" as deploy
participant "Terraform\n(S3 backend)" as tf
participant "AWS RDS\n(manage_master_user_password)" as rds
participant "AWS Secrets Manager\n(${prefix}/chatwoot)" as sm
participant "ExternalSecrets\nOperator (IRSA)" as eso
participant "K8s Secret\nchatwoot-env" as ks
participant "Chatwoot pod\n(envFromExistingSecret)" as pod

op -> env : fill OWNER, OAuth keys, etc.
op -> deploy : ./deploy.sh
deploy -> tf : terraform apply
tf -> rds : creates RDS with\nAWS-managed master password
rds -> sm : RDS writes password to\n*its own* AWS-owned secret
deploy -> rds : fetch master password\nfrom managed secret
deploy -> sm : put-secret-value\n(merged .env + TF outputs)
note right of sm
  Only **container** is in Terraform state;
  **values** are written by load-secrets.sh
  via aws-cli — never touch tfstate.
end note
sm <- eso : pull (IRSA, scoped to\n  ${prefix}/* ARN)
eso -> ks : project as K8s Secret
pod -> ks : envFromExistingSecret\n(env vars)

@enduml
