---
# ESO ClusterSecretStore — uses the IRSA role to authenticate to Secrets Manager.
apiVersion: external-secrets.io/v1beta1
kind: ClusterSecretStore
metadata:
  name: aws-secrets-manager
spec:
  provider:
    aws:
      service: SecretsManager
      region: {{ aws_region }}
      auth:
        jwt:
          serviceAccountRef:
            name: external-secrets
            namespace: external-secrets
---
# ExternalSecret — pulls the chatwoot secret payload and projects every JSON
# key as an env-var-shaped K8s Secret entry.
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: chatwoot-env
  namespace: {{ chatwoot_namespace }}
spec:
  refreshInterval: 1m
  secretStoreRef:
    name: aws-secrets-manager
    kind: ClusterSecretStore
  target:
    name: {{ chatwoot_k8s_secret }}
    creationPolicy: Owner
  dataFrom:
    - extract:
        key: {{ chatwoot_secret_name_in_aws }}
