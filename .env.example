# =============================================================================
# Chatwoot-TA — environment file
# Copy to `.env` and fill in. Empty values disable the corresponding feature.
# `.env` is git-ignored. Never commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Core identity / project naming
# -----------------------------------------------------------------------------
OWNER=                              # your name/handle (used in resource tags)
AWS_REGION=ap-southeast-1
NAME_PREFIX=cwta                    # short, lowercase, used as prefix for ALL resources
DOMAIN=support.labmgm.org
FRONTEND_URL=https://support.labmgm.org

# AWS profile (optional). If set, deploy.sh exports AWS_PROFILE=$AWS_PROFILE.
AWS_PROFILE=

# -----------------------------------------------------------------------------
# Cloudflare (authoritative DNS for labmgm.org + CDN/edge)
# Create a scoped API token with: Zone.DNS:Edit + Zone.Zone:Read for labmgm.org
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE=labmgm.org

# -----------------------------------------------------------------------------
# GitHub Actions (OIDC -> IAM role)
# -----------------------------------------------------------------------------
GITHUB_OWNER=
GITHUB_REPO=

# -----------------------------------------------------------------------------
# Chatwoot application
# Leave SECRET_KEY_BASE blank to auto-generate (64-byte hex) on first deploy.
# -----------------------------------------------------------------------------
INSTALLATION_NAME=Chatwoot
DEFAULT_LOCALE=en
RAILS_ENV=production
SECRET_KEY_BASE=
MAILER_SENDER_EMAIL=support@labmgm.org

# -----------------------------------------------------------------------------
# Filled by Terraform outputs at deploy time — LEAVE BLANK.
# deploy.sh reads Terraform outputs and writes these into Secrets Manager;
# they are NEVER stored in tfstate as plaintext.
# -----------------------------------------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

REDIS_URL=
REDIS_PASSWORD=
REDIS_SENTINEL_MASTER_NAME=

# S3 (ActiveStorage) — access via IRSA; no static keys required.
S3_BUCKET_NAME=
AWS_S3_REGION=

# Amazon SES outbound SMTP (creds generated by Terraform from SES SMTP user).
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=labmgm.org
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# -----------------------------------------------------------------------------
# Optional integrations — leave blank to disable each feature.
# -----------------------------------------------------------------------------

# Error / APM monitoring
SENTRY_DSN=
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com
SCOUT_KEY=
SCOUT_NAME=Chatwoot

# GeoIP (free GeoLite2 — sign up at maxmind.com)
MAXMIND_LICENSE_KEY=

# Rate limiting (Rack::Attack)
ENABLE_RACK_ATTACK=

# Stripe billing
STRIPE_SECRET_KEY=

# OpenAI (Chatwoot Captain / AI features)
OPENAI_API_KEY=

# OAuth — Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OAuth — Microsoft / Azure EntraID
AZURE_APP_ID=
AZURE_APP_SECRET=
AZURE_TENANT_ID=

# OIDC — Keycloak (on-prem; already configured, only consumed via env vars)
KEYCLOAK_OIDC_ISSUER=
KEYCLOAK_OIDC_CLIENT_ID=
KEYCLOAK_OIDC_CLIENT_SECRET=
# NOTE: Chatwoot Community has limited native SSO. We wire the OIDC env vars
# Chatwoot supports; full SSO/SCIM is an Enterprise feature.

# Web push (VAPID) — auto-generated if blank.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Mobile push (server-side only; only used if both blocks present)
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=

# -----------------------------------------------------------------------------
# Social channels — DISABLED by request. Leave blank.
# -----------------------------------------------------------------------------
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
IG_VERIFY_TOKEN=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Deploy-time flags (override defaults from CLAUDE.md §4)
# -----------------------------------------------------------------------------
# VPC_CIDR=10.42.0.0/16              # auto-shifted if it overlaps existing
# KUBERNETES_VERSION=1.32
# NODE_INSTANCE_TYPE=t3.large
# NODE_MIN=3
# NODE_DESIRED=2
# NODE_MAX=4
# RDS_INSTANCE_CLASS=db.t4g.small
# RDS_MULTI_AZ=true
# REDIS_NODE_TYPE=cache.t4g.micro

# Set PROCEED=yes in non-interactive runs (CI/dispatch) to skip the Phase 0 prompt.
PROCEED=
