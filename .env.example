# =============================================================================
# Chatwoot-TA environment file, aka the sacred scroll of configuration.
# copy it to .env and fill in the blanks. empty value = that feature takes a
# nap. .env is git-ignored, and if you commit a real secret here i will
# personally show up in your standup. don't do it.
# =============================================================================

# -----------------------------------------------------------------------------
# core identity. who are we, what's our name, where do we live.
# -----------------------------------------------------------------------------
OWNER=                              # your name/handle (goes on every resource tag)
AWS_REGION=ap-southeast-1
NAME_PREFIX=cwta                    # short, lowercase, used as prefix for ALL resources
DOMAIN=support.labmgm.org
FRONTEND_URL=https://support.labmgm.org

# AWS profile (optional). If set, deploy.sh exports AWS_PROFILE=$AWS_PROFILE.
AWS_PROFILE=

# -----------------------------------------------------------------------------
# Cloudflare (authoritative DNS for labmgm.org + CDN/edge)
# make a scoped token with: Zone.DNS:Edit + Zone.Zone:Read for labmgm.org
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE=labmgm.org

# -----------------------------------------------------------------------------
# GitHub Actions (OIDC -> IAM role)
# -----------------------------------------------------------------------------
GITHUB_OWNER=
GITHUB_REPO=

# -----------------------------------------------------------------------------
# Chatwoot application
# leave SECRET_KEY_BASE blank and the script rolls a 64-byte hex key on first
# deploy. like a loot box, but free and with more entropy.
# -----------------------------------------------------------------------------
INSTALLATION_NAME=Chatwoot
DEFAULT_LOCALE=en
RAILS_ENV=production
SECRET_KEY_BASE=
MAILER_SENDER_EMAIL=support@labmgm.org

# -----------------------------------------------------------------------------
# Filled by Terraform outputs at deploy time. LEAVE BLANK. i mean it.
# deploy.sh reads the outputs and drops these into Secrets Manager; they are
# NEVER written into tfstate as plaintext. tfstate doesn't need to know.
# -----------------------------------------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

REDIS_URL=
REDIS_PASSWORD=
REDIS_SENTINEL_MASTER_NAME=

# S3 (ActiveStorage) access rides IRSA; no static keys. keys are for boomers.
S3_BUCKET_NAME=
AWS_S3_REGION=

# Amazon SES outbound SMTP (creds generated by Terraform from SES SMTP user).
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=labmgm.org
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# -----------------------------------------------------------------------------
# Optional integrations. blank = off. this repo is peak "opt-in energy".
# -----------------------------------------------------------------------------

# Error / APM monitoring
SENTRY_DSN=
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com
SCOUT_KEY=
SCOUT_NAME=Chatwoot

# GeoIP (free GeoLite2; sign up at maxmind.com, it's painless. mostly.)
MAXMIND_LICENSE_KEY=

# Rate limiting (Rack::Attack). turn it on before the bots find you.
ENABLE_RACK_ATTACK=

# Stripe billing. money stuff.
STRIPE_SECRET_KEY=

# OpenAI (Chatwoot Captain / AI features). the robot assistant.
OPENAI_API_KEY=

# OAuth — Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OAuth — Microsoft / Azure EntraID
AZURE_APP_ID=
AZURE_APP_SECRET=
AZURE_TENANT_ID=

# OIDC — Keycloak (on-prem; already configured, only consumed via env vars)
KEYCLOAK_OIDC_ISSUER=
KEYCLOAK_OIDC_CLIENT_ID=
KEYCLOAK_OIDC_CLIENT_SECRET=
# NOTE: Chatwoot Community edition has limited native SSO. We wire the OIDC
# env vars the OSS build supports; full SSO/SCIM is an Enterprise feature.

# Web push (VAPID) auto-generated if blank. the browser wants to talk to you.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Mobile push (server-side only; only used if both blocks present)
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=

# -----------------------------------------------------------------------------
# Social channels DISABLED by request. leave blank. they had their chance.
# -----------------------------------------------------------------------------
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
IG_VERIFY_TOKEN=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Deploy-time flags (override the defaults baked into terraform/variables.tf)
# -----------------------------------------------------------------------------
# VPC_CIDR=10.42.0.0/16              # auto-shifted if it overlaps existing
# KUBERNETES_VERSION=1.32
# NODE_INSTANCE_TYPE=t3.large
# NODE_MIN=2
# NODE_DESIRED=2
# NODE_MAX=4
# RDS_INSTANCE_CLASS=db.t4g.small
# RDS_MULTI_AZ=true
# REDIS_NODE_TYPE=cache.t4g.micro

# Set PROCEED=yes in non-interactive runs (CI/dispatch) to skip the Phase 0 prompt.
PROCEED=
